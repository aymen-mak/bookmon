# ============================================================
# VFS Appointment Monitor - Configuration
# ============================================================
# Copy this to .env:  cp .env.example .env
# ============================================================

# --- VFS Account Credentials ---
VFS_EMAIL=your-email@example.com
VFS_PASSWORD=your-password

# --- VFS Route (Algeria → Italy defaults) ---
# Country you're applying FROM
VFS_COUNTRY_CODE=dza

# Country you're applying TO
VFS_MISSION_CODE=ita

# VAC (Visa Application Centre) code
# Run "python setup_helper.py" to see available centers
VFS_VAC_CODE=

# Visa category code
# Run "python setup_helper.py" after setting VAC_CODE to see categories
VFS_VISA_CATEGORY=

# Visa subcategory (leave empty if not applicable)
VFS_VISA_SUBCATEGORY=

# --- Monitoring ---
# Check interval in seconds (default: 180 = 3 minutes)
CHECK_INTERVAL_SECONDS=180

# --- Telegram Notifications ---
# 1. Message @BotFather on Telegram → /newbot → follow prompts → copy token
# 2. Start a chat with your bot
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates to get chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- reCAPTCHA Solving (Optional) ---
# Algeria requires reCAPTCHA on login and appointment endpoints.
# Option A: Get a 2captcha.com API key (~$3/1000 solves)
# Option B: Leave empty and use browser_login.py for manual CAPTCHA
CAPTCHA_API_KEY=
