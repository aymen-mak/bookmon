# ============================================================
# VFS Appointment Monitor - Configuration
# ============================================================
# Copy this to .env:  cp .env.example .env
# ============================================================

# --- VFS Account Credentials ---
VFS_EMAIL=your-email@example.com
VFS_PASSWORD=your-password

# --- VFS Route (Algeria → Italy) ---
VFS_COUNTRY_CODE=dza
VFS_MISSION_CODE=ita

# VAC (Visa Application Centre) code for Algiers
# Run "python setup_helper.py" to confirm the exact code
VFS_VAC_CODE=ALG

# Visa categories to monitor (comma-separated)
# Run "python setup_helper.py" to see available codes for your center.
# Example codes (verify with setup_helper.py, actual codes may differ):
#   Tourist + Business:  TOUR,BUS
#   Or if grouped:       SCH
VFS_VISA_CATEGORIES=TOUR,BUS

# --- Monitoring ---
# Check interval in seconds (default: 180 = 3 minutes)
CHECK_INTERVAL_SECONDS=180

# --- Telegram Notifications ---
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Start a chat with your bot
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates for chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- reCAPTCHA (Optional) ---
# Algeria requires reCAPTCHA. Leave empty to use browser_login.py instead.
CAPTCHA_API_KEY=
